              "value": "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"
