        "jsCode": "const dalleResponse = $input.first().json;\nconst contentData = $('Parse Claude Response').first().json;\n\n// URL image DALL-E (valide ~1h)\nconst imageUrl = dalleResponse.data[0].url;\n\nreturn [{\n  json: {\n    image_url: imageUrl,\n    full_caption: contentData.full_caption,\n    alt_text: contentData.alt_text\n  }\n}];"
      },
