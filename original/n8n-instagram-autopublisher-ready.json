        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\n  \"model\": \"claude-sonnet-4-6\",\n  \"max_tokens\": 1024,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Tu es expert copywriting Instagram.\\n\\nSujet: {{ $json.topic }}\\nNiche: {{ $json.niche }}\\nTon: {{ $json.tone }}\\n\\nGénère UNIQUEMENT ce JSON (pas d'explication autour) :\\n{\\n  \\\"caption\\\": \\\"[Hook percutant ligne 1 - max 125 chars]\\\\n\\\\n[Corps 3-4 phrases valeur réelle]\\\\n\\\\n[Call-to-action clair]\\\\n\\\\n[3-4 émojis pertinents intégrés naturellement]\\\",\\n  \\\"hashtags\\\": \\\"#hashtag1 #hashtag2 #hashtag3 #hashtag4 #hashtag5 #hashtag6 #hashtag7 #hashtag8 #hashtag9 #hashtag10 #hashtag11 #hashtag12 #hashtag13 #hashtag14 #hashtag15 #hashtag16 #hashtag17 #hashtag18 #hashtag19 #hashtag20\\\",\\n  \\\"image_prompt\\\": \\\"[Description DALL-E très détaillée: style photo pro ou illustration moderne, couleurs, ambiance, éléments visuels, format carré 1:1, qualité haute définition]\\\",\\n  \\\"alt_text\\\": \\\"[Description courte pour accessibilité Instagram]\\\"\\n}\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "a1b2c3d4-0003-0003-0003-000000000003",
      "name": "Claude - Generate Content",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\n\n// Extraire le texte de la réponse Claude\nconst rawText = response.content[0].text.trim();\n\n// Parser le JSON retourné par Claude\nlet parsed;\ntry {\n  // Chercher le JSON dans la réponse (au cas où Claude ajoute du texte)\n  const jsonMatch = rawText.match(/\\{[\\s\\S]*\\}/);\n  if (!jsonMatch) throw new Error('No JSON found in Claude response');\n  parsed = JSON.parse(jsonMatch[0]);\n} catch(e) {\n  throw new Error(`Parse error: ${e.message} | Raw: ${rawText.substring(0, 200)}`);\n}\n\n// Construire la caption finale (caption + saut de ligne + hashtags)\nconst fullCaption = `${parsed.caption}\\n\\n${parsed.hashtags}`;\n\nreturn [{\n  json: {\n    caption: parsed.caption,\n    hashtags: parsed.hashtags,\n    image_prompt: parsed.image_prompt,\n    alt_text: parsed.alt_text || '',\n    full_caption: fullCaption\n  }\n}];"
      },
      "id": "a1b2c3d4-0004-0004-0004-000000000004",
